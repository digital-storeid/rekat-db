# Rekat DB - Environment Variables Template
# Copy file ini menjadi .env untuk local development:  cp .env.example .env
# JANGAN commit file .env ke git (sudah di .gitignore)
# Isi di Netlify Dashboard: Site > Configuration > Environment variables

# OpenRouter API Key - dapatkan di https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site URL untuk header HTTP-Referer (wajib untuk OpenRouter analytics)
SITE_URL=https://rekat-db.netlify.app

# Optional: override URL jika deploy preview
# URL=https://rekat-db.netlify.app
